\begin{luacode*}
local file = "KDM.tex"
local fh = io.open(file, "r")
if fh then
  local content = fh:read("*a")
  fh:close()

  content = content:gsub("%%.-\n", "\n")
  content = content:gsub("\\[%a%*]+", " ")
  content = content:gsub("%b{}", " ")
  content = content:gsub("%$.-%$", " ")
  content = content:gsub("%s+", " ")

  local words = 0
  for _ in content:gmatch("%S+") do
    words = words + 1
  end

  local chars = #content:gsub("%s+", "")
  tex.sprint(string.format("\\gdef\\wordcount{%s}", words))
  tex.sprint(string.format("\\gdef\\charcount{%s}", chars))
else
  tex.sprint("\\gdef\\wordcount{0}")
  tex.sprint("\\gdef\\charcount{0}")
end
\end{luacode*}

